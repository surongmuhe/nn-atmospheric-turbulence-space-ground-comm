    "target_col": "LogCn2",
    "seq_len": 72,
    "pred_len": 6,
    "resample_rule": "5min",
    "source_train_ratio": 0.7,
    "source_val_ratio": 0.15,
    "target_mode": "delta",
    "target_aggregation": "mean"
