      "pad_steps": 1
    },
    "domain_features": {
      "enabled": false
    },
    "solar_regime_features": {
      "enabled": false
    },
    "diff_features": {
      "enabled": true,
      "columns": [
        "LogCn2",
        "Tair",
        "UmSonic"
      ],
      "periods": [
        1
      ]
    },
    "rolling_features": {
      "enabled": true,
      "columns": [
        "LogCn2",
        "Tair",
        "UmSonic"
      ],
      "windows": [
        3,
        12
      ],
      "include_mean": true,
      "include_std": true,
      "include_min": false,
      "include_max": false
