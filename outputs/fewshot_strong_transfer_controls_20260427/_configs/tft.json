    "active_models": [
      "tft"
    ],
    "regime_split": {
      "enabled": false
    }
  },
  "train": {
    "batch_size": 128,
    "epochs": 35,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "optimizer": "adamw",
    "scheduler": {
      "type": "plateau",
      "factor": 0.6,
      "patience": 2,
      "min_lr": 1e-05
    },
    "shuffle_train": true,
    "early_stop_patience": 10,
    "num_workers": 0,
    "grad_clip_norm": 1.0,
    "show_progress": false,
    "loss": {
