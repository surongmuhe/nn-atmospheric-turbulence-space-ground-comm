{
  "project": {
    "name": "fewshot_strong_transfer_tft",
    "seed": 42,
    "output_dir": "C:\\Users\\33640\\Desktop\\lstm\\fusion_forecasting_project\\outputs\\fewshot_strong_transfer_controls_20260427\\tft",
    "log_level": "INFO"
  },
  "data": {
    "source_file_path": "data/Sklavounos and Cohn, Spring. 2022.xlsx",
    "source_datetime_col": "Date",
    "source_time_col": "Time",
    "target_file_path": "data/dataWfon0U_ml_ready.csv",
    "target_datetime_col": "time",
    "target_time_col": null,
    "feature_cols": [
      "LogCn2",
      "Tair",
      "Pair",
      "UmSonic",
      "is_daylight",
      "hour_sin",
      "hour_cos"
