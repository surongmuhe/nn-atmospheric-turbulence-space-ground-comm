      "d_model": 128,
      "nhead": 4,
      "num_layers": 3,
      "ff_dim": 256,
      "dropout": 0.1,
      "pooling": "mean",
      "max_patches": 128
    }
  },
  "wandb": {
    "enabled": false,
    "project": null,
    "entity": null,
    "run_name": null
  }
}